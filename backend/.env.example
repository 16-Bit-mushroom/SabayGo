ENVIRONMENT=development
DEBUG=true
DATABASE_URL=mysql+asyncmy://sabaygo_app:sabaygo_app_dev@127.0.0.1:3307/sabaygo
JWT_SECRET=
AI_NODE_URL=http://localhost:5000
AI_NODE_API_KEY=
PHONE_CAPTURE_API_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- SOS emergency alerts (spec 2.3.5) -------------------------------
# disabled | android_gateway | twilio
#
# android_gateway: a spare Android handset on the cooperative's SIM running
# an SMS-gateway app (e.g. capcom6/android-sms-gateway, Apache-2.0). FOSS,
# no vendor account, no per-message charge. SMS_GATEWAY_URL points at that
# handset on the LAN.
#
# twilio: paid per segment. A trial account can only text numbers verified
# in the Twilio console -- enough for a demo, not for a fleet.
#
# Leave disabled and the alert is still recorded and the office still
# notified in-app; every recipient simply gets a dispatch row saying no
# attempt was made. Who is texted is the `sos_contact_numbers` cooperative
# policy, edited in the console's Policy Editor -- not an env var.
SMS_PROVIDER=disabled
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
